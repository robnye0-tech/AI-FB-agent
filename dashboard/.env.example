# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: server-only, never expose to the browser.
# Used for privileged operations (e.g. webhook handlers) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL this app is deployed at (used to build the email-confirmation
# redirect link). Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
